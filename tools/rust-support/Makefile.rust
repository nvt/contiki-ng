# Rust support for Contiki-NG
# This makefile provides build rules and configuration for Rust code integration

# Rust source file extension
RUST_EXTENSION = .rs

# Rust flags for embedded development
RUSTFLAGS_COMMON = -C opt-level=s -C panic=abort -C lto=fat
RUSTFLAGS_EMBEDDED = --emit=obj -C relocation-model=static

# Default values if not set
RUSTC ?= rustc
CARGO ?= cargo
RUST_TARGET ?= thumbv7m-none-eabi

# Target-specific Rust targets
ifeq ($(TARGET),native)
  RUST_TARGET = $(shell rustc -vV | sed -n 's/host: \(.*\)/\1/p' 2>/dev/null || echo x86_64-unknown-linux-gnu)
  RUSTFLAGS = $(RUSTFLAGS_COMMON) --emit=obj -C relocation-model=pic
else ifeq ($(TARGET),zoul)
  RUST_TARGET = thumbv7m-none-eabi
  RUSTFLAGS = $(RUSTFLAGS_COMMON) $(RUSTFLAGS_EMBEDDED) --target=$(RUST_TARGET)
else ifeq ($(TARGET),cc2538dk)
  RUST_TARGET = thumbv7m-none-eabi
  RUSTFLAGS = $(RUSTFLAGS_COMMON) $(RUSTFLAGS_EMBEDDED) --target=$(RUST_TARGET)
else ifeq ($(TARGET),nrf52840)
  RUST_TARGET = thumbv7em-none-eabihf
  RUSTFLAGS = $(RUSTFLAGS_COMMON) $(RUSTFLAGS_EMBEDDED) --target=$(RUST_TARGET)
else ifeq ($(TARGET),sky)
  RUST_TARGET = msp430-none-elf
  RUSTFLAGS = $(RUSTFLAGS_COMMON) $(RUSTFLAGS_EMBEDDED) --target=$(RUST_TARGET)
else
  # Default to no_std for unknown targets
  RUST_TARGET = thumbv7m-none-eabi
  RUSTFLAGS = $(RUSTFLAGS_COMMON) $(RUSTFLAGS_EMBEDDED) --target=$(RUST_TARGET)
endif

# Add Rust runtime support
RUST_RUNTIME_C = $(CONTIKI)/tools/rust-support/rust-runtime.c
PROJECT_SOURCEFILES += $(notdir $(RUST_RUNTIME_C))
SOURCEDIRS += $(dir $(RUST_RUNTIME_C))

# Auto-detect Rust source files in SOURCEDIRS (unless disabled)
ifndef RUST_NO_AUTO_DETECT
  RUST_AUTO_SOURCES := $(foreach dir,$(SOURCEDIRS),$(wildcard $(dir)/*.rs))
  RUST_AUTO_SOURCES := $(notdir $(RUST_AUTO_SOURCES))
  # Add auto-detected sources if not already present
  # Use immediate assignment to avoid recursion
  PROJECT_SOURCEFILES := $(PROJECT_SOURCEFILES) $(filter-out $(PROJECT_SOURCEFILES),$(RUST_AUTO_SOURCES))
endif

# Add Rust object files to the build
RUST_SOURCEFILES = $(filter %$(RUST_EXTENSION), $(PROJECT_SOURCEFILES))
RUST_OBJECTFILES = $(addprefix $(OBJECTDIR)/,$(RUST_SOURCEFILES:$(RUST_EXTENSION)=.o))

# Update object files list
oname = $(patsubst %.c,%.o,$(patsubst %.cpp,%.o,$(patsubst %.rs,%.o,$(patsubst %.S,%.o,$(patsubst %.s,%.o,$(1))))))

# Rust compilation rule
$(OBJECTDIR)/%.o: %.rs | $(OBJECTDIR)
	$(TRACE_CC)
	$(Q)$(RUSTC) $(RUSTFLAGS) -L $(CONTIKI)/tools/rust-support/target/$(RUST_TARGET)/release/deps \
	  -o $@ $<

# Ensure Rust core library is available for the target
ifndef RUST_SETUP_DEFINED
RUST_SETUP_DEFINED = 1
.PHONY: rust-setup
rust-setup:
	@if [ "$(TARGET)" != "native" ]; then \
	  if command -v rustup >/dev/null 2>&1; then \
	    if ! rustup target list --installed | grep -q $(RUST_TARGET); then \
	      echo "Installing Rust target $(RUST_TARGET)..."; \
	      rustup target add $(RUST_TARGET); \
	    fi \
	  else \
	    if ! rustc --print target-list | grep -q "^$(RUST_TARGET)$$"; then \
	      echo "Error: Rust target $(RUST_TARGET) not available and rustup not found"; \
	      exit 1; \
	    fi \
	  fi \
	fi
endif

# Add rust-setup as a prerequisite for Rust object files
$(RUST_OBJECTFILES): rust-setup

# Size reporting targets
.PHONY: rust-size rust-size-report

rust-size: $(RUST_OBJECTFILES)
	@echo "=== Rust Module Sizes ==="
	@if [ -n "$(RUST_OBJECTFILES)" ]; then \
	  for obj in $(RUST_OBJECTFILES); do \
	    if [ -f "$$obj" ]; then \
	      echo ""; \
	      echo "File: $$obj"; \
	      size "$$obj" 2>/dev/null || echo "  (size command not available)"; \
	    fi; \
	  done; \
	else \
	  echo "No Rust object files found"; \
	fi
	@echo ""

rust-size-report: rust-size
	@echo "=== Total Rust Code Size ==="
	@if [ -n "$(RUST_OBJECTFILES)" ] && command -v size >/dev/null 2>&1; then \
	  total_text=0; total_data=0; total_bss=0; \
	  for obj in $(RUST_OBJECTFILES); do \
	    if [ -f "$$obj" ]; then \
	      eval $$(size "$$obj" 2>/dev/null | awk 'NR==2 {print "text="$$1" data="$$2" bss="$$3}'); \
	      total_text=$$((total_text + text)); \
	      total_data=$$((total_data + data)); \
	      total_bss=$$((total_bss + bss)); \
	    fi; \
	  done; \
	  echo "Total text (code):  $$total_text bytes"; \
	  echo "Total data (initialized): $$total_data bytes"; \
	  echo "Total bss (uninitialized): $$total_bss bytes"; \
	  echo "Total ROM usage: $$((total_text + total_data)) bytes"; \
	  echo "Total RAM usage: $$((total_data + total_bss)) bytes"; \
	else \
	  echo "(size command not available or no Rust objects)"; \
	fi
	@echo ""

# Testing targets
.PHONY: rust-test rust-test-lib

rust-test-lib:
	@echo "=== Running Rust Library Tests ==="
	@cd $(CONTIKI)/tools/rust-support && $(CARGO) test --lib
	@echo ""

rust-test: rust-test-lib
	@echo "=== Running Rust Module Tests ==="
	@if [ -n "$(RUST_SOURCEFILES)" ]; then \
	  for rs in $(RUST_SOURCEFILES); do \
	    if [ -f "$$rs" ]; then \
	      echo "Testing $$rs..."; \
	      $(RUSTC) --test $$rs -o /tmp/rust-test-$$$$ 2>/dev/null && \
	        /tmp/rust-test-$$$$ && rm -f /tmp/rust-test-$$$$ || \
	        echo "  (no tests or compilation failed)"; \
	    fi; \
	  done; \
	else \
	  echo "No Rust source files found"; \
	fi
	@echo ""