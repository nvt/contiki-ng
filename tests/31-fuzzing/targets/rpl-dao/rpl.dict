# Tokens for RPL control messages, as defined by RFC 6550 and RFC 6554.
icmp6_type_rpl="\x9b"
rpl_code_dis="\x9b\x00"
rpl_code_dio="\x9b\x01"
rpl_code_dao="\x9b\x02"
rpl_code_dao_ack="\x9b\x03"
opt_dag_conf="\x04\x0e"
opt_target="\x05\x12"
opt_transit_storing="\x06\x04"
opt_transit_nonstoring="\x06\x14"
opt_prefix_info="\x08\x20"
opt_route_info="\x03"
opt_solicited_info="\x07\x13"
opt_padn="\x01"
srh_routing_type="\x03"
next_header_routing="\x2b"
next_header_icmp6="\x3a"
next_header_hop_by_hop="\x00"
