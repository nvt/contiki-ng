# CoAP header bytes and option deltas, as defined by RFC 7252.
ver_con_tkl0="\x40"
ver_non_tkl0="\x50"
ver_ack_tkl0="\x60"
ver_rst_tkl0="\x70"
code_get="\x01"
code_post="\x02"
code_put="\x03"
code_delete="\x04"
opt_uri_path="\xb1"
opt_content_format="\xc1"
opt_block2="\xd1"
opt_payload_marker="\xff"
opt_extended_13="\x0d"
opt_extended_14="\x0e"
