iphc_ll_from_mac="\x33"
iphc_ctx_from_mac="\x77"
iphc_cid="\x80"
iphc_multicast_8bit="\x0b"
nhc_udp_inline="\xf0"
nhc_udp_4bit_ports="\xf3"
nhc_udp_no_checksum="\xf4"
nhc_ext_hbh="\xe0"
nhc_ext_routing="\xe2"
nhc_ext_frag="\xe4"
nhc_ext_desto="\xe6"
nhc_ext_ipv6="\xee"
next_header_udp="\x11"
next_header_icmp6="\x3a"
next_header_hop_by_hop="\x00"
next_header_routing="\x2b"
next_header_frag="\x2c"
rpl_hbh_option="\x63\x04"
